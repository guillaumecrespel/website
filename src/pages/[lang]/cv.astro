---
/**
 * Printable resume. Viewable online, printable from the browser, and the
 * source of the PDF files (see scripts/generate-assets.ts).
 * Page 1 is a visual overview; the experience timeline starts on page 2.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '@/assets/images/avatar.png';
import SEO from '@/components/SEO.astro';
import TechIcon from '@/components/TechIcon.astro';
import type { Experience } from '@/i18n/data/experiences/types';
import {
  cityOf,
  durationInMonths,
  formatDuration,
  formatMonth,
  isOngoing,
} from '@/i18n/data/experiences/utils';
import { getSocialLink } from '@/i18n/data/profile';
import { EXPERIENCE_SECTORS, getSectorLabel } from '@/i18n/data/sectors';
import { LANGS, type Lang, useTranslations } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BUILD_DATE, getSiteContent } from '@/lib/content';
import { SHARE_SHEET_ID } from '@/lib/share';
import { absoluteUrl, cvPath, cvPdfPath, homePath, otherLang } from '@/lib/site';
import { graph, PERSON_ID, profilePageNode } from '@/lib/structured-data';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const content = getSiteContent(lang);
const { profile, experiences, ui, stats } = content;
const path = cvPath(lang);
const title = t('meta.cvTitle');
const description = t('meta.cvDescription', { years: stats.years });

// Ongoing missions show the most; older ones are summarised (full detail stays online).
function achievementLimit(startDate: string, ongoing: boolean): number {
  if (ongoing) return 5;
  if (startDate >= '2020-01-01') return 4;
  return 3;
}
const COMPACT_BEFORE = '2016-01-01';
const detailed = experiences.filter((exp) => exp.startDate >= COMPACT_BEFORE || isOngoing(exp));
const compact = experiences.filter((exp) => !detailed.includes(exp));

const period = (exp: Experience) => ({
  start: formatMonth(lang, exp.startDate),
  end: exp.endDate ? formatMonth(lang, exp.endDate) : t('experiences.present'),
  duration: formatDuration(lang, durationInMonths(exp)),
});

const skills = [...content.productSkills.skills, ...content.softSkills.skills];

const levelRows = [
  { label: ui.technologies.levels.expert, levels: ['expert'], compact: false },
  { label: ui.technologies.levels.senior, levels: ['senior'], compact: false },
  { label: ui.technologies.levels.intermediate, levels: ['intermediate'], compact: false },
  // Long tail (incl. most AI tooling) as one line of text to keep page 1 on one page.
  { label: ui.cv.stackOther, levels: ['beginner', 'learning'], compact: true },
]
  .map((row) => ({
    ...row,
    technologies: content.rankedTechnologies.filter((tech) => row.levels.includes(tech.level)),
  }))
  .filter((row) => row.technologies.length > 0);

const statTiles = [
  { value: stats.years, label: ui.stats.years, color: '#ffc700' },
  { value: stats.companies, label: ui.stats.companies, color: '#fca3ff' },
  { value: stats.products, label: ui.stats.products, color: '#68d4fb' },
  { value: stats.sectors, label: ui.stats.sectors, color: '#5ef1a5' },
];

const linkedin = getSocialLink(profile, 'linkedin');
const malt = getSocialLink(profile, 'malt');
const github = getSocialLink(profile, 'github');
const contacts = [
  { icon: 'lucide:map-pin', label: profile.location.label, href: '' },
  { icon: 'lucide:globe', label: 'guillaumecrespel.fr', href: absoluteUrl(homePath(lang)) },
  linkedin && {
    icon: 'fa6-brands:linkedin-in',
    label: 'linkedin.com/in/guillaume-crespel',
    href: linkedin.url,
  },
  malt && { icon: 'malt', label: 'malt.fr/profile/guillaumecrespel', href: malt.url },
  github && { icon: 'fa6-brands:github', label: 'github.com/guillaumecrespel', href: github.url },
  profile.email && { icon: 'lucide:mail', label: profile.email, href: `mailto:${profile.email}` },
].filter((item): item is { icon: string; label: string; href: string } => Boolean(item));

const updated = new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(BUILD_DATE);
// Short display strings (tagline, labels) carry no trailing period.
const tagline = profile.title.replace(/\.$/, '');
const jobMeta = (exp: Experience) => {
  const sector = EXPERIENCE_SECTORS[exp.id];
  return [
    cityOf(exp.location),
    t(`experiences.workType.${exp.workType}`),
    sector ? getSectorLabel(lang, sector) : null,
  ]
    .filter(Boolean)
    .join(' · ');
};

const jsonLd = graph([
  profilePageNode({
    lang,
    url: absoluteUrl(path),
    title,
    description,
    imageUrl: absoluteUrl('/og/portrait.jpg'),
    dateModified: BUILD_DATE.toISOString(),
  }),
  { '@type': 'Person', '@id': PERSON_ID, name: profile.name },
]);
---

<BaseLayout lang={lang} backdrop={false} share="cv" bodyClass="cv-body">
  <SEO
    slot="head"
    lang={lang}
    title={title}
    description={description}
    path={path}
    alternatePath={cvPath(otherLang(lang))}
    defaultPath={cvPath('fr')}
    jsonLd={jsonLd}
  />

  <nav class="cv-toolbar no-print" aria-label={ui.cv.online}>
    <a href={homePath(lang)} class="brutal brutal-interactive cv-btn">
      <Icon name="lucide:arrow-left" aria-hidden="true" />
      <span class="cv-btn__label">{t('actions.backToSite')}</span>
    </a>
    <div class="cv-toolbar__group">
      <a href={cvPath(otherLang(lang))} hreflang={otherLang(lang)} lang={otherLang(lang)} class="brutal brutal-interactive cv-btn">
        {t('actions.switchLangShort')}
      </a>
      <button type="button" commandfor={SHARE_SHEET_ID} command="show-modal" class="brutal brutal-interactive cv-btn">
        <Icon name="lucide:share-2" aria-hidden="true" />
        <span class="cv-btn__label">{t('share.button')}</span>
      </button>
      <a href={cvPdfPath(lang)} download class="brutal brutal-interactive cv-btn cv-btn--main">
        <Icon name="lucide:file-down" aria-hidden="true" />
        {t('actions.downloadCv')}
      </a>
    </div>
  </nav>

  <article class="cv" aria-label={title}>
    <!-- Page 1: overview -->
    <header class="cv-head">
      <div>
        <h1>{profile.name}</h1>
        <p class="cv-role"><span class="cv-marker">{profile.role}</span></p>
        <p class="cv-tagline">{tagline}</p>
        <ul class="cv-contacts">
          {
            contacts.map((contact) => (
              <li>
                <Icon name={contact.icon} aria-hidden="true" />
                {contact.href ? <a href={contact.href}>{contact.label}</a> : contact.label}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="cv-photo">
        <Image src={avatar} alt="" width={160} height={160} densities={[1, 2]} loading="eager" />
      </div>
    </header>

    <section class="cv-summary" aria-labelledby="cv-overview">
      <h2 id="cv-overview" class="sr-only">{ui.cv.overview}</h2>
      <p class="cv-summary__text">{t('cv.summary', { years: stats.years, products: stats.products })}</p>
      <dl class="cv-stats">
        {
          statTiles.map((tile) => (
            <div>
              <dt>{tile.label}</dt>
              <dd>{tile.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="cv-overview">
      <section aria-labelledby="cv-expertise">
        <h2 id="cv-expertise" class="cv-h2">{ui.cv.expertise}</h2>
        <ul class="cv-skills">
          {
            skills.map((skill) => (
              <li>
                <Icon name={skill.icon} class="cv-skills__shape" aria-hidden="true" />
                <div>
                  <strong>{skill.name}</strong>
                  <span>{skill.description}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="cv-overview__side">
        <section aria-labelledby="cv-offers">
          <h2 id="cv-offers" class="cv-h2">{ui.cv.offers}</h2>
          <ul class="cv-offers">
            {
              content.offers.offers.map((offer) => (
                <li>
                  <Icon name={offer.icon} aria-hidden="true" />
                  {offer.name}
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="cv-sectors">
          <h2 id="cv-sectors" class="cv-h2">{ui.cv.sectors}</h2>
          <ul class="cv-sectors">
            {content.sectors.map((sector) => <li>{sector.label}</li>)}
          </ul>
        </section>
      </div>
    </div>

    <section class="cv-block" aria-labelledby="cv-stack">
      <h2 id="cv-stack" class="cv-h2">{ui.cv.stack}</h2>
      <dl class="cv-stack">
        {
          levelRows.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>
                {row.compact ? (
                  <p class="cv-stack__compact">{row.technologies.map((tech) => tech.name).join(' · ')}</p>
                ) : (
                  <ul>
                    {row.technologies.map((tech) => (
                      <li>
                        <TechIcon technology={tech} class="cv-tech-icon" />
                        {tech.name}
                      </li>
                    ))}
                  </ul>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-block" aria-labelledby="cv-apps">
      <h2 id="cv-apps" class="cv-h2">
        {ui.cv.apps}
        <span class="cv-h2__note">Unirakun</span>
      </h2>
      <ul class="cv-apps">
        {
          content.saas.saas.map((product) => (
            <li>
              <span
                class:list={['cv-apps__logo', `cv-apps__logo--${product.iconKind}`]}
                style={`background:${product.bgColor};color:${product.fgColor}`}
              >
                <Icon name={product.icon} aria-hidden="true" />
              </span>
              <div>
                <strong>{product.name}</strong>
                <a href={product.url}>{new URL(product.url).host}</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Experience -->
    <section class="cv-experience" aria-labelledby="cv-experience">
      <h2 id="cv-experience" class="cv-h2">{ui.cv.experience}</h2>

      <ol class="cv-jobs">
        {
          detailed.map((exp) => {
            const p = period(exp);
            const achievements = exp.achievements.slice(0, achievementLimit(exp.startDate, isOngoing(exp)));
            return (
              <li class="cv-job">
                <div class="cv-job__aside">
                  <img src={exp.company.logo} alt="" width="40" height="40" class="cv-job__logo" />
                  <p class="cv-job__dates">
                    <time datetime={exp.startDate.slice(0, 7)}>{p.start}</time>
                    <span>{p.end}</span>
                  </p>
                  <p class="cv-job__duration">{p.duration}</p>
                </div>
                <div class="cv-job__main">
                  <h3>{exp.position}</h3>
                  <p class="cv-job__company">
                    <strong>{exp.company.name}</strong> · {jobMeta(exp)}
                  </p>
                  <p class="cv-job__desc">{exp.description}</p>
                  {achievements.length > 0 && (
                    <ul class="cv-job__bullets">
                      {achievements.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                  {exp.technologies.length > 0 && (
                    <p class="cv-job__stack">{exp.technologies.join(' · ')}</p>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>

      {
        compact.length > 0 && (
          <div class="cv-earlier">
            <h3 class="cv-earlier__title">{ui.cv.earlier}</h3>
            <ul>
              {compact.map((exp) => {
                const p = period(exp);
                return (
                  <li>
                    <img src={exp.company.logo} alt="" width="24" height="24" />
                    <div>
                      <strong>{exp.position}</strong> · {exp.company.name}
                      <span class="cv-earlier__stack">{exp.technologies.slice(0, 6).join(' · ')}</span>
                    </div>
                    <time datetime={exp.startDate.slice(0, 7)}>
                      {p.start} – {p.end}
                    </time>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }
    </section>

    <footer class="cv-foot">
      {ui.cv.updated} {updated} · <a href={absoluteUrl(path)}>{absoluteUrl(path).replace('https://', '')}</a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .cv-body {
    background: var(--surface-2);
  }

  /* Screen-only toolbar (site styles) */
  .cv-toolbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    max-width: 210mm;
    margin: 0 auto;
    padding: 16px;
  }
  .cv-toolbar__group {
    display: flex;
    gap: 12px;
  }
  .cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 14px;
    font-weight: 600;
  }
  .cv-btn svg {
    width: 16px;
    height: 16px;
  }
  .cv-btn--main {
    background: var(--main);
    color: var(--main-fg);
  }
  @media (max-width: 520px) {
    .cv-toolbar,
    .cv-toolbar__group {
      gap: 8px;
    }
    .cv-btn:has(.cv-btn__label),
    .cv-btn[hreflang] {
      justify-content: center;
      width: 44px;
      padding: 0;
    }
    .cv-btn__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /*
   * The sheet. Warm ink on white paper, three text roles, hairlines, one
   * accent (the site mint) used as a highlighter under the role only.
   * Spacing sits on a 4px grid.
   */
  .cv {
    --ink: #1f1b16;
    --ink-2: #5e554a;
    --ink-3: #7b7266;
    --hair: rgb(31 27 22 / 0.12);
    --raised: #f7f4ee;
    --accent: #5ef1a5;
    color-scheme: light;
    box-sizing: border-box;
    width: 210mm;
    max-width: 100%;
    margin: 0 auto 48px;
    padding: 56px 56px 40px;
    background: #fff;
    color: var(--ink);
    border: 2px solid #0b0b0c;
    box-shadow: 6px 6px 0 0 #0b0b0c;
    font-size: 12px;
    line-height: 1.5;
  }
  .cv a {
    color: inherit;
    text-decoration: none;
  }
  .cv svg {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .cv-h2 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 12px;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    break-after: avoid;
  }
  .cv-h2::after {
    content: '';
    flex: 1;
    height: 1px;
    margin-left: 4px;
    background: var(--hair);
    align-self: center;
  }
  .cv-h2__note {
    font-weight: 400;
    color: var(--ink-3);
  }

  /* Header */
  .cv-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: end;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--hair);
  }
  .cv-head h1 {
    font-size: 36px;
    font-weight: 600;
    line-height: 40px;
    letter-spacing: -0.02em;
  }
  .cv-role {
    margin-top: 8px;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
  }
  /* Signature: the site highlighter, used once. */
  .cv-marker {
    background: linear-gradient(var(--accent), var(--accent)) 0 85% / 100% 0.42em no-repeat;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .cv-tagline {
    margin-top: 4px;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-2);
  }
  .cv-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 16px;
    font-size: 11px;
    line-height: 16px;
    color: var(--ink-2);
  }
  .cv-contacts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cv-contacts svg {
    width: 12px;
    height: 12px;
    color: var(--ink-3);
  }
  .cv-photo {
    position: relative;
    width: 112px;
    height: 136px;
    overflow: hidden;
    border: 1.5px solid #0b0b0c;
    border-radius: 56px 56px 0 0;
    background: var(--accent);
  }
  .cv-photo img {
    position: absolute;
    bottom: -1%;
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: top;
  }

  /* Summary and key figures */
  .cv-summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--hair);
  }
  .cv-summary__text {
    font-size: 13px;
    line-height: 20px;
  }
  .cv-stats {
    display: grid;
    grid-template-columns: repeat(2, 104px);
    gap: 16px 24px;
  }
  .cv-stats > div {
    display: flex;
    flex-direction: column;
  }
  .cv-stats dt {
    order: 2;
    font-size: 10px;
    line-height: 14px;
    color: var(--ink-3);
  }
  .cv-stats dd {
    order: 1;
    font-size: 24px;
    font-weight: 500;
    line-height: 28px;
    font-variant-numeric: tabular-nums;
  }

  /* Expertise, engagement models, industries */
  .cv-overview {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px;
    margin-top: 24px;
  }
  .cv-overview__side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .cv-skills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 20px;
  }
  .cv-skills li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .cv .cv-skills__shape {
    width: 28px;
    height: 28px;
    margin-top: 2px;
  }
  .cv-skills strong {
    display: block;
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
  }
  .cv-skills span {
    display: block;
    margin-top: 2px;
    font-size: 10.5px;
    line-height: 14px;
    color: var(--ink-2);
  }
  .cv-offers {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cv-offers li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 20px;
    font-weight: 500;
  }
  .cv-offers svg {
    width: 14px;
    height: 14px;
    color: var(--ink-3);
  }
  .cv-sectors {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
    font-size: 11px;
    line-height: 18px;
    color: var(--ink-2);
  }
  /* Labels never break inside; a middot separates them. */
  .cv-sectors li {
    white-space: nowrap;
  }
  .cv-sectors li:not(:last-child)::after {
    content: ' ·';
  }

  .cv-block {
    margin-top: 24px;
  }

  /* Tech stack: real logos, no pills */
  .cv-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cv-stack > div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    align-items: start;
  }
  .cv-stack dt {
    font-size: 11px;
    line-height: 20px;
    color: var(--ink-3);
  }
  .cv-stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  .cv-stack li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 500;
    line-height: 20px;
  }
  .cv .cv-tech-icon {
    width: 12px;
    height: 12px;
    border-width: 0.8px;
    border-radius: 3px;
    font-size: 5px;
  }
  .cv-stack__compact {
    font-size: 11px;
    line-height: 18px;
    color: var(--ink-2);
  }

  /* SaaS apps: logo, name, address */
  .cv-apps {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }
  .cv-apps li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .cv-apps li > div {
    min-width: 0;
  }
  .cv-apps__logo {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    overflow: hidden;
    border: 1px solid var(--hair);
    border-radius: 6px;
  }
  .cv .cv-apps__logo svg {
    width: 70%;
    height: 70%;
  }
  .cv .cv-apps__logo--color svg {
    width: 100%;
    height: 100%;
  }
  .cv-apps__logo--logo svg path {
    /* biome-ignore lint/complexity/noImportantStyles: recolour single-colour brand logos */
    fill: currentColor !important;
  }
  .cv-apps strong {
    display: block;
    font-size: 11px;
    font-weight: 600;
    line-height: 14px;
  }
  .cv-apps a {
    display: block;
    overflow: hidden;
    font-size: 9.5px;
    line-height: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-3);
  }

  /* Experience */
  .cv-experience {
    margin-top: 32px;
    break-before: page;
  }
  .cv-jobs {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cv-job {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    break-inside: avoid;
  }
  .cv-job__aside {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .cv-job__logo {
    width: 36px;
    height: 36px;
    border: 1px solid var(--hair);
    border-radius: 8px;
    background: #fff;
    object-fit: cover;
  }
  .cv-job__dates {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
  }
  .cv-job__dates span {
    font-weight: 400;
    color: var(--ink-2);
  }
  .cv-job__duration {
