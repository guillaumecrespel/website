---
import type { Experience } from '@/i18n/data/experiences/types';
import { durationInMonths, formatDuration, formatPeriod } from '@/i18n/data/experiences/utils';
import { type Lang, useTranslations } from '@/i18n/ui';

interface Props {
  lang: Lang;
  experience: Experience;
  /** Optional line under the title (e.g. how a technology was used). */
  note?: string;
  /** Link to the full entry in the timeline. */
  href?: string;
}

const { lang, experience, note, href } = Astro.props;
const t = useTranslations(lang);
const period = formatPeriod(lang, experience, t('experiences.present'));
const duration = formatDuration(lang, durationInMonths(experience));
---

<article class="xp-mini">
  <img src={experience.company.logo} alt="" width="48" height="48" loading="lazy" decoding="async" />
  <div>
    <h3>{href ? <a href={href}>{experience.position}</a> : experience.position}</h3>
    <p>{experience.company.name} · <time datetime={experience.startDate.slice(0, 7)}>{period}</time> · {duration}</p>
    {note && <p class="note">{note}</p>}
  </div>
</article>

<style>
  .xp-mini {
    position: relative;
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 2px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    transition: background-color 150ms ease;
  }
  .xp-mini:hover {
    background: var(--surface-2);
  }
  img {
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border: 2px solid var(--line);
    border-radius: 0.75rem;
    object-fit: cover;
  }
  div {
    min-width: 0;
  }
  h3 {
    font-weight: 600;
    line-height: 1.3;
  }
  a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  p {
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
  .note {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--fg);
    text-wrap: pretty;
  }
</style>
