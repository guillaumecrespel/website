---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '@/assets/images/avatar.png';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { type Lang, useTranslations } from '@/i18n/ui';
import { SHARE_SHEET_ID } from '@/lib/share';
import { cvPdfPath, homePath, otherLang } from '@/lib/site';

interface Props {
  lang: Lang;
  /** Same page in the other language. */
  alternatePath: string;
  /** In-page sections for the navigation (home page only). */
  sections?: { id: string; label: string }[];
}

const { lang, alternatePath, sections = [] } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const home = homePath(lang);
const isHome = Astro.url.pathname === home;
const sectionHref = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);
---

<header class="site-header sticky top-0 z-40 backdrop-blur-md no-print">
  <div
    class="mx-auto flex h-[var(--header-h)] max-w-6xl items-center justify-between gap-3 px-4 md:px-6"
  >
    <a
      href={isHome ? '#top' : home}
      class="group flex min-w-0 items-center gap-2.5 rounded-full pr-2 font-bold"
      aria-label={`Guillaume Crespel · ${t('nav.home')}`}
    >
      <span class="grid size-9 shrink-0 place-items-end overflow-hidden rounded-full border-2 border-line bg-main">
        <Image src={avatar} alt="" width={36} height={36} densities={[1, 2]} class="size-9 object-cover" />
      </span>
      <span class="truncate text-[0.95rem] tracking-tight max-[420px]:sr-only">Guillaume Crespel</span>
    </a>

    {
      sections.length > 0 && (
        <nav aria-label={t('nav.label')} class="hidden lg:block">
          <ul class="flex items-center gap-1 text-sm font-medium">
            {sections.map((section) => (
              <li>
                <a
                  href={sectionHref(section.id)}
                  data-nav-link
                  class="rounded-full px-3 py-1.5 transition-colors hover:bg-surface aria-[current=true]:bg-fg aria-[current=true]:text-bg"
                >
                  {section.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        commandfor={SHARE_SHEET_ID}
        command="show-modal"
        class="brutal brutal-interactive grid size-10 place-items-center rounded-full bg-surface"
        aria-label={t('share.buttonLong')}
        title={t('share.buttonLong')}
      >
        <Icon name="lucide:share-2" class="size-[1.15rem]" aria-hidden="true" />
      </button>
      <a
        href={cvPdfPath(lang)}
        download
        class="brutal brutal-interactive hidden h-10 items-center gap-2 rounded-full bg-surface px-4 text-sm font-semibold sm:inline-flex"
      >
        <Icon name="lucide:file-down" class="size-4" aria-hidden="true" />
        {t('actions.cv')}
      </a>
      <a
        href={cvPdfPath(lang)}
        download
        class="brutal brutal-interactive grid size-10 place-items-center rounded-full bg-surface sm:hidden"
        aria-label={t('actions.downloadCv')}
        title={t('actions.downloadCv')}
      >
        <Icon name="lucide:file-down" class="size-[1.15rem]" aria-hidden="true" />
      </a>
      <a
        href={alternatePath}
        hreflang={other}
        lang={other}
        class="brutal brutal-interactive grid size-10 place-items-center rounded-full bg-surface text-sm font-bold"
        aria-label={t('actions.switchLang')}
        title={t('actions.switchLang')}
      >
        {t('actions.switchLangShort')}
      </a>
      <ThemeToggle lang={lang} />
      {
        sections.length > 0 && (
          <button
            type="button"
            popovertarget="site-menu"
            class="brutal brutal-interactive grid size-10 place-items-center rounded-full bg-main text-main-fg lg:hidden"
            aria-label={t('nav.menu')}
          >
            <Icon name="lucide:menu" class="size-5" aria-hidden="true" />
          </button>
        )
      }
    </div>
  </div>

  {
    sections.length > 0 && (
      <nav
        id="site-menu"
        popover
        aria-label={t('nav.label')}
        class="brutal fixed inset-auto top-[calc(var(--header-h)+0.5rem)] right-4 m-0 w-[min(18rem,calc(100vw-2rem))] rounded-3xl bg-surface p-3 text-fg lg:hidden"
      >
        <ul class="flex flex-col">
          {sections.map((section) => (
            <li>
              <a
                href={sectionHref(section.id)}
                data-nav-link
                class="flex items-center justify-between rounded-2xl px-4 py-3 text-lg font-semibold hover:bg-surface-2 aria-[current=true]:bg-main aria-[current=true]:text-main-fg"
              >
                {section.label}
                <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>
