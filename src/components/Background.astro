---
/**
 * Decorative page background: the site's shapes (circle, half disc, ring,
 * spark, rounded square) peek in from the edges and drift with the scroll.
 * Pure CSS: a few small SVGs moved by a scroll-driven animation (compositor
 * only), static where scroll timelines or motion are not available.
 */
---

<div class="backdrop" aria-hidden="true">
  <svg class="shape shape--circle" viewBox="0 0 100 100"><circle cx="50" cy="50" r="47"></circle></svg>
  <svg class="shape shape--half" viewBox="0 0 100 52"><path d="M2 50a48 48 0 0 1 96 0z"></path></svg>
  <svg class="shape shape--ring" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40"></circle></svg>
  <svg class="shape shape--spark" viewBox="0 0 100 100">
    <path d="M50 2c4 30 18 44 48 48-30 4-44 18-48 48-4-30-18-44-48-48 30-4 44-18 48-48z"></path>
  </svg>
  <svg class="shape shape--square" viewBox="0 0 100 100"><rect x="6" y="6" width="88" height="88" rx="14"></rect></svg>
</div>

<style is:global>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }

  .shape {
    position: absolute;
    overflow: visible;
    fill: var(--shape-fill, none);
    stroke: color-mix(in oklab, var(--line) 55%, transparent);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
  }

  .dark .shape {
    opacity: 0.32;
  }

  /* Shapes peek in from the edges so they never sit behind text. */
  .shape--circle {
    --shape-fill: var(--main);
    --speed: 0.6;
    width: 15rem;
    top: 22vh;
    right: -8rem;
  }

  .shape--half {
    --shape-fill: var(--yellow);
    --speed: 1;
    width: 11rem;
    top: 64vh;
    left: -6.5rem;
    rotate: 90deg;
  }

  .shape--ring {
    --speed: 0.4;
    width: 12rem;
    bottom: -5rem;
    right: 18vw;
    stroke: var(--violet);
    stroke-width: 10;
  }

  .shape--spark {
    --shape-fill: var(--pink);
    --speed: 1.3;
    width: 5rem;
    top: 9vh;
    right: 1.5rem;
  }

  .shape--square {
    --shape-fill: var(--sky);
    --speed: 0.8;
    width: 5rem;
    bottom: 14vh;
    left: -2.2rem;
    rotate: 14deg;
  }

  /* Phones: smaller shapes, pushed further out of the reading column. */
  @media (max-width: 640px) {
    .shape--circle {
      width: 9rem;
      right: -6rem;
    }
    .shape--half {
      width: 7rem;
      left: -4.5rem;
    }
    .shape--ring {
      width: 8rem;
      bottom: 12vh;
      right: -5rem;
    }
    .shape--spark {
      width: 3rem;
      top: auto;
      bottom: 34vh;
      right: -0.75rem;
    }
    .shape--square {
      width: 3.5rem;
      left: -1.8rem;
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .shape {
        animation: shape-drift linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes shape-drift {
    to {
      translate: 0 calc(var(--speed) * -45vh);
    }
  }
</style>
