---
import { Icon } from 'astro-icon/components';
import SectionHeader from '@/components/SectionHeader.astro';
import type { Experience } from '@/i18n/data/experiences/types';
import {
  cityOf,
  durationInMonths,
  formatDuration,
  formatPeriod,
  isOngoing,
} from '@/i18n/data/experiences/utils';
import { EXPERIENCE_SECTORS, getSectorLabel } from '@/i18n/data/sectors';
import { type Lang, useTranslations } from '@/i18n/ui';
import { cvPath, cvPdfPath } from '@/lib/site';

interface Props {
  lang: Lang;
  /** Section number shown before the title. */
  index: string;
  experiences: Experience[];
}

const { lang, index, experiences } = Astro.props;
const t = useTranslations(lang);
const VISIBLE_TECH = 6;
---

<section id="experience" aria-labelledby="experience-title" class="scroll-mt-24">
  <SectionHeader headingId="experience-title" index={index} title={t('experiences.title')} lead={t('experiences.lead')} />

  <ol class="relative flex flex-col gap-5 before:absolute before:top-2 before:bottom-2 before:left-[0.6rem] before:w-0.5 before:bg-line md:gap-6 md:before:left-[0.85rem]">
    {
      experiences.map((experience) => {
        const ongoing = isOngoing(experience);
        const sector = EXPERIENCE_SECTORS[experience.id];
        const period = formatPeriod(lang, experience, t('experiences.present'));
        const duration = formatDuration(lang, durationInMonths(experience));
        const extraTech = experience.technologies.slice(VISIBLE_TECH);
        return (
          <li id={`xp-${experience.id}`} class="timeline-item relative scroll-mt-24 pl-8 md:pl-12" data-play>
            {ongoing ? (
              <span class="timeline-dot timeline-dot--ongoing" aria-hidden="true">
                <span class="size-2 rounded-full bg-line motion-safe:animate-pulse md:size-2.5" />
              </span>
            ) : (
              <span class="timeline-dot timeline-dot--done" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="timeline-check">
                  <path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1" />
                </svg>
              </span>
            )}

            <article class="timeline-card brutal reveal rounded-card bg-surface p-4 md:p-6">
              <header class="flex gap-4">
                <img
                  src={experience.company.logo}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  decoding="async"
                  class="size-12 shrink-0 rounded-xl border-2 border-line object-cover md:size-14"
                />
                <div class="min-w-0 flex-1">
                  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-fg-muted">
                    <time datetime={experience.startDate.slice(0, 7)}>{period}</time>
                    <span aria-hidden="true">·</span>
                    <span>{duration}</span>
                    {ongoing && (
                      <span class="rounded-full border-2 border-line bg-yellow px-2 py-px text-xs font-bold text-[#0b0b0c]">
                        {t('experiences.ongoing')}
                      </span>
                    )}
                  </p>
                  <h3 class="mt-1 text-xl leading-tight font-bold tracking-tight md:text-2xl">{experience.position}</h3>
                  <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                    <span class="font-semibold">{experience.company.name}</span>
                    <span aria-hidden="true" class="text-fg-muted">·</span>
                    <span class="text-fg-muted">{cityOf(experience.location)}</span>
                    <span class="rounded-full border border-line px-2 py-px text-xs font-medium">
                      {t(`experiences.workType.${experience.workType}`)}
                    </span>
                    {sector && (
                      <span class="rounded-full border border-line bg-surface-2 px-2 py-px text-xs font-medium">
                        {getSectorLabel(lang, sector)}
                      </span>
                    )}
                  </p>
                </div>
              </header>

              <p class="mt-4 text-pretty text-fg-muted">{experience.description}</p>

              {experience.technologies.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t('experiences.stack')}>
                  {experience.technologies.slice(0, VISIBLE_TECH).map((tech) => (
                    <li class="rounded-lg border-2 border-line bg-surface-2 px-2 py-0.5 text-xs font-semibold">{tech}</li>
                  ))}
                  {extraTech.length > 0 && (
                    <li class="rounded-lg border-2 border-dashed border-line px-2 py-0.5 text-xs font-semibold">
                      +{extraTech.length}
                    </li>
                  )}
                </ul>
              )}

              {experience.achievements.length > 0 && (
                <details class="mt-4 border-t-2 border-dashed border-line/40 pt-3">
                  <summary class="inline-flex items-center gap-1.5 rounded-full text-sm font-semibold underline decoration-2 underline-offset-4 hover:decoration-main">
                    <span class="when-closed">
                      {t('actions.seeDetails')} ({experience.achievements.length})
                    </span>
                    <span class="when-open">{t('actions.hideDetails')}</span>
                    <Icon name="lucide:chevron-down" class="chevron size-4 transition-transform" aria-hidden="true" />
                  </summary>
                  <div class="details-body grid gap-5 pt-4 md:grid-cols-[2fr_1fr]">
                    <div>
                      <h4 class="mb-2 text-sm font-bold tracking-wide uppercase">{t('experiences.achievements')}</h4>
                      <ul class="flex flex-col gap-2">
                        {experience.achievements.map((achievement) => (
                          <li class="flex gap-2 text-pretty">
                            <Icon name="lucide:check" class="mt-1 size-4 shrink-0 text-fg" aria-hidden="true" />
                            <span>{achievement}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="flex flex-col gap-4">
                      {experience.skills.length > 0 && (
                        <div>
                          <h4 class="mb-2 text-sm font-bold tracking-wide uppercase">{t('experiences.skills')}</h4>
                          <ul class="flex flex-wrap gap-1.5">
                            {experience.skills.map((skill) => (
                              <li class="rounded-lg border border-line px-2 py-0.5 text-xs font-medium">{skill}</li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {extraTech.length > 0 && (
                        <div>
                          <h4 class="mb-2 text-sm font-bold tracking-wide uppercase">{t('experiences.stack')}</h4>
                          <ul class="flex flex-wrap gap-1.5">
                            {experience.technologies.map((tech) => (
                              <li class="rounded-lg border-2 border-line bg-surface-2 px-2 py-0.5 text-xs font-semibold">{tech}</li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  </div>
                </details>
              )}
            </article>
          </li>
        );
      })
    }
  </ol>

  <div class="mt-8 flex flex-wrap gap-3 pl-8 md:pl-12">
    <a
      href={cvPdfPath(lang)}
      download
      class="brutal brutal-interactive inline-flex h-11 items-center gap-2 rounded-full bg-main px-5 font-semibold text-main-fg"
    >
      <Icon name="lucide:file-down" class="size-4" aria-hidden="true" />
      {t('actions.downloadCv')}
    </a>
    <a
      href={cvPath(lang)}
      class="brutal brutal-interactive inline-flex h-11 items-center gap-2 rounded-full bg-surface px-5 font-semibold"
    >
      <Icon name="lucide:file-text" class="size-4" aria-hidden="true" />
      {t('actions.viewCv')}
    </a>
  </div>
</section>
